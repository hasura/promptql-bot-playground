# Copied to .env by scripts/install.sh. Recommended values for the Playground Project:
PORT="8790"
# Per-data-plane internal address. Never hardcode — take it from the bot VM shell: echo $PROMPTQL_PLATFORM_API_URL
PROMPTQL_PLATFORM_API_URL="<value of $PROMPTQL_PLATFORM_API_URL on your bot VM>"
# Integration provider id (must match the app artifact's required_permissions.integrations)
HF_PROVIDER="higgsfield-user-private"
# Display name of that integration in PromptQL "My Data" — shown to users in setup step 2
HF_PROVIDER_LABEL="Higgsfield"